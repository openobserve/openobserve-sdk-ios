abstract_target 'Common' do
  pod 'OpenTelemetry-Swift-Api', '2.3.0'
  pod 'OpenObserveInternal', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveCore', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveLogs', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveTrace', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveRUM', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveCore', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveSessionReplay', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveCrashReporting', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveFlags', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE
  pod 'OpenObserveProfiling', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE

  target 'App Dynamic iOS' do
    platform :ios, '13.0'
    use_frameworks!
    pod 'OpenObserveWebViewTracking', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE

    target 'App Dynamic iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static iOS' do
    platform :ios, '13.0'
    pod 'OpenObserveWebViewTracking', :git => 'https://github.com/openobserve/openobserve-sdk-ios.git', :GIT_REFERENCE

    target 'App Static iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Dynamic tvOS' do
    platform :tvos, '13.0'
    use_frameworks!

    target 'App Dynamic tvOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static tvOS' do
    platform :tvos, '13.0'

    target 'App Static tvOS Tests' do
      inherit! :search_paths
    end
  end

end
