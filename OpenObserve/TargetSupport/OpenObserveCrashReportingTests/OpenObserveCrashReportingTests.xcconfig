// Add common settings from OpenObserve.xcconfig
#include "../xcconfigs/OpenObserve.xcconfig"

// Both 'OpenObserveSDKTesting' and 'OpenObserveCrashReporting' link PLCR dependency statically, resulting with these runtime warnings:
//
//       """
//       objc[50310]: Class PLCrashReportThreadInfo is implemented in both
//       /Users/.../OpenObserveCrashReporting.framework/OpenObserveCrashReporting (0x10b727208)
//       and
//       /Users/.../OpenObserveSDKTesting.framework/OpenObserveSDKTesting (0x10b5ee928).
//       One of the two will be used. Which one is undefined.
//       """
//
//       Because some mocks in 'OpenObserveCrashReportingTests' use PLCR type's subclassing, their runtime cast with 'as? <PLCR_TYPE>' could fail depending in which library is found first
// We force 'OpenObserveCrashReporting' to be linked before linking 'OpenObserveSDKTesting' so PLCR symbols are found in that library.
OTHER_LDFLAGS= $(inherited) -framework OpenObserveCrashReporting

// Add OpenObserveSDKTesting instrumentation (if available in current environment)
 #include? "../xcconfigs/OpenObserveSDKTesting.local.xcconfig"


